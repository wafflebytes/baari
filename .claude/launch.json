{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "baari-app",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4174",
        "--directory",
        "app"
      ],
      "port": 4174
    },
    {
      "name": "baari-rails",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server.js"
      ],
      "cwd": "baari-mock",
      "port": 3939,
      "env": {
        "ADMIN_KEY": "local-test-key",
        "BOT_TOKEN": "",
        "MCP_API_KEY": "local-mcp-key"
      }
    },
    {
      "name": "baari-pages",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd app && npx wrangler pages dev . --port 8788"
      ],
      "port": 8788
    }
  ]
}
