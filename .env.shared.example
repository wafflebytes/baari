# Baari shared env. NEVER COMMIT. Send to Vinay directly (not through git or commit comments).
# Copy the lines each tool needs into its own .env (agenticorg-cli/.env, baari-mock/.env, evals/.env, workers).

# Cloudflare (Global API key: full account access; swap for a scoped API token when there's time)
CLOUDFLARE_API_KEY=
CLOUDFLARE_EMAIL=
CLOUDFLARE_ACCOUNT_ID=

# OpenRouter (simulated humans, LLM judges, eval replica, C3 extraction on rails)
OPENROUTER_API_KEY=
OPENROUTER_MODEL_SIM=
OPENROUTER_MODEL_REPLICA=

# AgenticOrg (one shared login, Vinay's account). Run `node ao.js login`, then delete the password.
AO_BASE=
AO_EMAIL=
AO_PASSWORD=

# Rails (Vinay fills from Vercel env)
RAILS_BASE=
RAILS_ADMIN_KEY=
RAILS_MCP_KEY=
TELEGRAM_BOT_USERNAME=
